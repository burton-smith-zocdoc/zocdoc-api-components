{
  "name": "powered-by-zocdoc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:theme && pnpm run analyze",
    "build:types": "tsc --build tsconfig.build.json",
    "build:theme": "oxnode scripts/build-theme.ts",
    "typecheck": "pnpm run build:types && tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm run build:types && vitest run",
    "test:client": "pnpm run build:types && vitest run --project client",
    "test:components": "pnpm run build:types && vitest run --project components",
    "analyze": "cem analyze --litelement --globs \"packages/*/src/**/*.ts\" --exclude \"**/*.stories.ts\" --exclude \"**/*.test.ts\"",
    "storybook": "pnpm run build:types && pnpm run analyze && storybook dev -p 6006",
    "storybook:build": "pnpm run build:types && pnpm run analyze && storybook build",
    "demo": "pnpm --filter demo dev"
  },
  "devDependencies": {
    "@charm-ux/theming": "link:../charm-ux/core/packages/theming",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@oxc-node/cli": "^0.1.0",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/web-components": "^10.5.5",
    "@storybook/web-components-vite": "^10.5.5",
    "@types/node": "^24.3.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@wc-toolkit/cem-analyzer-plugin": "^1.0.2",
    "@wc-toolkit/cem-inheritance": "^1.2.0",
    "@wc-toolkit/cem-sorter": "^1.0.1",
    "@wc-toolkit/jsdoc-tags": "^1.2.1",
    "@wc-toolkit/module-path-resolver": "^1.0.1",
    "@wc-toolkit/storybook-helpers": "^10.7.3",
    "@wc-toolkit/type-parser": "^1.3.0",
    "axe-core": "^4.12.1",
    "lit": "^3.2.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "storybook": "^10.5.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vitest": "^4.1.10"
  },
  "customElements": "custom-elements.json"
}
