@inject IOptions<ZocdocOptions> Zocdoc
@{
    var options = Zocdoc.Value;
}
@* The bundle configures itself from these meta tags (see packages/api-components/src/bundle.ts). *@
@if (options.IsLive)
{
    <meta name="zocdoc-api-key" content="@options.Token" />
    <meta name="zocdoc-api-base-url" content="@options.BaseUrl" />
}
else
{
    <meta name="zocdoc-api-mock" content="true" />
}
<script src="~/zocdoc/zocdoc.js"></script>
