{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "preserve",
    "allowImportingTsExtensions": true,
    "paths": {
      "vue": ["./node_modules/vue"]
    }
  },
  "include": ["env.d.ts", "src/**/*.ts", "src/**/*.vue"]
}
