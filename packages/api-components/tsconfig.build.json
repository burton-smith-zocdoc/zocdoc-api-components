{
  // References primitives rather than including its sources, so a build of this package
  // typechecks against primitives' emitted declarations — the same thing a consumer sees
  // through its `exports` map. Cross-package drift shows up here instead of at install time.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  // `mock/` is built, unlike `test/`: the demo site reaches it through the `./mock` subpath, so
  // it has to exist in `dist`. It stays out of the main entry point and out of anything the
  // components import, which is what keeps fixtures out of a consumer's bundle — importing `.`
  // pulls in none of it.
  "exclude": ["**/*.test.ts", "**/*.stories.ts", "**/test/**"],
  "references": [{ "path": "../primitives/tsconfig.build.json" }]
}
