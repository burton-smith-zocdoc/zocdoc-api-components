---
/**
 * Diagram of `<zd-booking>` and the child components it wires together, with the event each child emits.
 */
const children = [
  { tag: 'zd-provider-search', event: 'provider-results' },
  { tag: 'zd-provider-results', event: 'provider-select' },
  { tag: 'zd-availability-picker', event: 'slot-select' },
  { tag: 'zd-patient-form', event: 'patient-submit' },
  { tag: 'zd-booking-confirmation' },
];
---

<figure class="hierarchy not-content">
  <figcaption class="parent">
    <code>&lt;zd-booking&gt;</code>
    <span class="role">Listens for events and passes properties down</span>
  </figcaption>
  <ul class="children">
    {
      children.map(({ tag, event }) => (
        <li class="child">
          <code class="tag">&lt;{tag}&gt;</code>
          {event && (
            <span class="event">
              <span aria-hidden="true">↑</span>
              <span class="label">emits</span>
              <code>{event}</code>
            </span>
          )}
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .hierarchy {
    margin-block: 1.5rem;
    padding: 1rem 1.25rem 1.25rem;
    border: 2px solid var(--sl-color-accent);
    border-radius: 0.75rem;
    background: var(--sl-color-accent-low);

    & code {
      font-family: var(--sl-font-mono);
    }
  }

  .parent {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-block-end: 1rem;

    & code {
      font-size: var(--sl-text-lg);
      font-weight: 600;
      color: var(--sl-color-accent-high);
    }

    & .role {
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-2);
    }
  }

  .children {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .child {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-black);

    & .tag {
      color: var(--sl-color-white);
    }

    & .event {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      margin-inline-start: auto;
      padding: 0.125rem 0.625rem;
      border-radius: 999px;
      font-size: var(--sl-text-xs);
      color: var(--sl-color-gray-3);
      background: var(--sl-color-gray-6);

      & .label {
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      & code {
        color: var(--sl-color-accent-high);
      }
    }
  }
</style>
