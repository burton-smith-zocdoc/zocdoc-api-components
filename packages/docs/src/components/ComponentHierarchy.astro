---
/**
 * Diagram of `<zd-booking>` and the child components it wires together, with the event each child emits.
 */
const steps = [
  { tag: 'zd-provider-search', event: 'provider-results' },
  { tag: 'zd-provider-results', event: 'provider-select' },
  { tag: 'zd-availability-picker', event: 'slot-select' },
  { tag: 'zd-patient-form', event: 'patient-submit' },
  { tag: 'zd-booking-confirmation' },
];
---

<figure class="hierarchy not-content">
  <figcaption class="parent">
    <code>&lt;zd-booking&gt;</code>
    <span class="role">Parent: listens for events and passes properties down</span>
  </figcaption>
  <ol class="steps">
    {
      steps.map(({ tag, event }, index) => (
        <li class="step">
          <span class="index" aria-hidden="true">{index + 1}</span>
          <code class="tag">&lt;{tag}&gt;</code>
          {event && (
            <span class="event">
              <span class="label">emits</span>
              <code>{event}</code>
            </span>
          )}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .hierarchy {
    margin-block: 1.5rem;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));

    & code {
      font-family: var(--sl-font-mono);
    }
  }

  .parent {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin-block-end: 1rem;

    & code {
      font-size: var(--sl-text-lg);
      font-weight: 600;
      color: var(--sl-color-accent-high);
    }

    & .role {
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
  }

  .steps {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-inline-start: 3px solid var(--sl-color-accent);
    border-radius: 0.5rem;
    background: var(--sl-color-black);

    /* Connector between consecutive steps */
    &:not(:last-child)::after {
      content: '';
      position: absolute;
      inset-block-start: 100%;
      inset-inline-start: 1.6rem;
      block-size: 0.75rem;
      border-inline-start: 2px dashed var(--sl-color-gray-4);
    }

    & .index {
      display: inline-grid;
      place-items: center;
      inline-size: 1.5rem;
      block-size: 1.5rem;
      border-radius: 50%;
      font-size: var(--sl-text-xs);
      font-weight: 600;
      color: var(--sl-color-accent-high);
      background: var(--sl-color-accent-low);
    }

    & .tag {
      color: var(--sl-color-white);
    }

    & .event {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      margin-inline-start: auto;
      padding: 0.125rem 0.625rem;
      border-radius: 999px;
      font-size: var(--sl-text-xs);
      background: var(--sl-color-gray-6);

      & .label {
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--sl-color-gray-3);
      }

      & code {
        color: var(--sl-color-accent-high);
      }
    }
  }
</style>
