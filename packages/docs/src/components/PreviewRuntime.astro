---
/**
 * Loads the component bundle and configures the mock transport.
 * Include this component once on any page with live previews.
 */
---

<script>
  import { CodeBubble } from 'code-bubble';
  import '@zocdoc/api-primitive-components';
  import '@zocdoc/api-primitive-components/theme/tokens.css';
  import '@zocdoc/api-primitive-components/theme/utilities.css';
  import '@zocdoc/api-primitive-components/theme/layout-elements.css';
  import themeSource from '@zocdoc/api-primitive-components/theme/all.css?raw';
  import bundleSource from '@zocdoc/api-components/bundle/iife?raw';
  import { configureZocdocMock } from '@zocdoc/api-components/mock';
  import '@zocdoc/api-components';

  // The fixtures' `/images/…` photos live under the site's base path, not the origin root.
  configureZocdocMock({ assetBaseUrl: import.meta.env.BASE_URL });

  new CodeBubble({
    sandbox: 'stackblitz',
    component: {
      sandboxButton: { hide: true },
    },
    sandboxConfig: {
      stackBlitz: {
        html: {
          project: {
            title: 'Zocdoc API Components example',
            description: 'Interactive example using mock component data.',
            files: {
              'libs/zocdoc.js': bundleSource,
              'libs/theme.css': themeSource,
            },
          },
          exampleTemplate: {
            fileName: 'index.html',
            template: `<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="libs/theme.css" />
    <meta name="zocdoc-api-mock" content="true" />
    <script src="libs/zocdoc.js"></scr${'ipt'}>
  </head>
  <body>
    %example%
  </body>
</html>`,
          },
        },
      },
    },
  });

  /*
   * code-bubble re-runs every `<script>` in a preview as JavaScript, so an inline JSON data block
   * (`type="application/json"`) would be wrapped in a function and throw. Re-run only the scripts
   * a browser would execute, and leave data blocks in place for the components to read.
   */
  type LoadScripts = (this: HTMLElement, preview: HTMLElement) => void;
  const bubble = customElements.get('code-bubble')?.prototype as
    | { loadScripts?: LoadScripts }
    | undefined;
  const loadScripts = bubble?.loadScripts;
  if (bubble && loadScripts) {
    bubble.loadScripts = function (preview) {
      const data = [...preview.querySelectorAll('script')].filter(
        (script) => script.type && script.type !== 'text/javascript' && script.type !== 'module'
      );
      const placeholders = data.map((script) => {
        const marker = document.createComment('');
        script.replaceWith(marker);
        return marker;
      });
      loadScripts.call(this, preview);
      placeholders.forEach((marker, index) => marker.replaceWith(data[index]!));
    };
  }
</script>
