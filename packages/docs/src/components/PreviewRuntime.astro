---
/**
 * Loads the component bundle and configures the mock transport.
 * Include this component once on any page with live previews.
 */
---

<script>
  import { CodeBubble } from 'code-bubble';
  import '@zocdoc/api-primitive-components/theme/tokens.css';
  import themeSource from '@zocdoc/api-primitive-components/theme/all.css?raw';
  import bundleSource from '@zocdoc/api-components/bundle/iife?raw';
  import { configureZocdocMock } from '@zocdoc/api-components/mock';
  import '@zocdoc/api-components';

  configureZocdocMock();

  new CodeBubble({
    sandbox: 'stackblitz',
    sandboxConfig: {
      stackBlitz: {
        html: {
          project: {
            title: 'Zocdoc API Components example',
            description: 'Interactive example using mock component data.',
            files: {
              'libs/zocdoc.js': bundleSource,
              'libs/theme.css': themeSource,
            },
          },
          exampleTemplate: {
            fileName: 'index.html',
            template: `<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="libs/theme.css" />
    <script src="libs/zocdoc.js" zd-mock></scr${'ipt'}>
  </head>
  <body>
    %example%
  </body>
</html>`,
          },
        },
      },
    },
  });
</script>
