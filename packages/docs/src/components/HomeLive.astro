---
/** Homepage live example: the one-tag drop-in from the install section, running on sample data. */
import PreviewRuntime from './PreviewRuntime.astro';
---

<PreviewRuntime />

<section class="live not-content" aria-labelledby="live-heading">
  <h2 id="live-heading">See it live</h2>
  <p class="lead">
    This is the <code>&lt;zd-booking&gt;</code> tag above, running on sample data. Try a search.
  </p>
  <div class="frame">
    <zd-booking zip-code="11201"></zd-booking>
  </div>
</section>

<style>
  .live {
    margin-block: 4rem;

    & h2 {
      margin: 0;
      font-size: var(--sl-text-3xl);
      text-align: center;
    }
  }

  .lead {
    margin: 0.5rem 0 2rem;
    color: var(--sl-color-gray-2);
    text-align: center;
  }

  .frame {
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1rem;
    background: var(--sl-color-bg);
    box-shadow: 0 1.5rem 3rem -1.5rem rgb(0 0 0 / 0.25);
  }
</style>
