---
interface Props {
  code: string;
  lang?: string;
}

const { code, lang = 'html' } = Astro.props;
const escapeHtml = (value: string) => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');
const languageClass = `language-${lang}`;
---

<code-bubble class="component-preview" sandbox="stackblitz">
  <pre><code class={languageClass} set:html={escapeHtml(code)}></code></pre>
</code-bubble>
